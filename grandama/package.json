{
  "name": "project-grandma",
  "version": "1.0.0",
  "description": "Steps Recorder - Grandma style (record steps to explain anything clearly)",
  "main": "main.js",
  "Author": "Khotso Tsoaela",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktsoaela/project_grandma.git"
  },
  "scripts": {
    "start": "electron .",
    "start:electron": "electron .",
    "start:python": "node scripts/start-recorder.js",
    "dev": "concurrently -n js,py -c blue,green \"npm run start:electron\" \"npm run start:python\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:show": "playwright test --headed -g \"visits 3 docs pages\"",
    "test:full": "playwright test --headed -g \"start Grandma, check options\" && node scripts/open-full-report.js",
    "build:recorder": "bash ../recorder/build_executable.sh",
    "build": "electron-builder",
    "build:win": "npm run build:recorder && electron-builder --win --publish=never",
    "build:mac": "npm run build:recorder && electron-builder --mac --publish=never",
    "build:all": "npm run build:recorder && electron-builder -mw --publish=never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.grandma.steps-recorder",
    "productName": "Project Grandma",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../recorder",
        "to": "recorder",
        "filter": [
          "**/*.py",
          "requirements.txt",
          "dist/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Grandma"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
